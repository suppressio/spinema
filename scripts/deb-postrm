#!/bin/sh
set -e

mark_begin="# >>> spinema >>>"
mark_end="# <<< spinema <<<"
base=/srv/spinema

case "$1" in
    remove|purge)
        if mountpoint -q "$base/Disks"; then
            fusermount3 -u "$base/Disks" || umount "$base/Disks" || true
        fi
        if grep -qsF "$mark_begin" /etc/samba/smb.conf; then
            sed -i "/^${mark_begin}\$/,/^${mark_end}\$/d" /etc/samba/smb.conf
            if testparm -s >/dev/null 2>&1 &&
                    [ -d /run/systemd/system ] &&
                    command -v deb-systemd-invoke >/dev/null; then
                deb-systemd-invoke reload smbd.service || true
            fi
        fi
        # the mount point used before the Disks/Spinema rename, if still left over
        rmdir "$base/Disks" "$base" /srv/bd3d 2>/dev/null || true
        ;;
esac

if [ "$1" = purge ] && getent group spinema >/dev/null; then
    groupdel spinema || true
fi
