#!/bin/sh
set -e

group=spinema
base=/srv/spinema
smb_conf=/etc/samba/smb.conf
mark_begin="# >>> spinema >>>"
mark_end="# <<< spinema <<<"

if ! getent group "$group" >/dev/null; then
    # the package was called bluray3d-xr before the rename: keep its group (and members)
    if grep -q '^bluray3d-xr:' /etc/group; then
        groupmod --new-name "$group" bluray3d-xr
    else
        groupadd --system "$group"
    fi
fi
install -d -o root -g "$group" -m 2775 "$base"
# the mount point used before the Disks/Spinema rename: spinema creates and
# mounts Disks inside $base itself, so this is left over once empty
rmdir /srv/bd3d 2>/dev/null || true

# FUSE and Samba are only recommended: --share dlna needs neither. Configure
# them when installed; installing Samba later runs this again ("triggered",
# see the smbd trigger in build-deb.sh)
if [ -f /etc/fuse.conf ] && ! grep -qxF user_allow_other /etc/fuse.conf; then
    printf '%s\n' user_allow_other >> /etc/fuse.conf
fi

# the Samba server, not only smb.conf: samba-common (pulled in by desktops)
# writes smb.conf without smbd or testparm
command -v smbd >/dev/null || exit 0
if [ ! -f "$smb_conf" ]; then
    echo "spinema: $smb_conf not found, [Spinema] share not added: run 'sudo dpkg-reconfigure spinema' once Samba is configured" >&2
    exit 0
fi
if grep -qF "$mark_begin" "$smb_conf"; then
    sed -i "/^${mark_begin}\$/,/^${mark_end}\$/d" "$smb_conf"
fi
# the same share added by a native install from before the rename (bluray3d-xr)
sed -i '/^# >>> bluray3d-xr >>>$/,/^# <<< bluray3d-xr <<<$/d' "$smb_conf"
cat >> "$smb_conf" <<SHARE

$mark_begin
[Spinema]
   path = $base
   comment = Blu-ray and DVD, played on the fly
   read only = yes
   guest ok = yes
   browseable = yes
$mark_end
SHARE

testparm -s >/dev/null
if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null; then
    deb-systemd-invoke reload smbd.service || true
fi
